{
  "name": "kervox",
  "version": "1.0.0",
  "private": true,
  "description": "KERVOX - South African Medical Insurer Operating System",
  "scripts": {
    "predev": "node scripts/policy-data/kill-duplicate-ports.js",
    "dev": "pnpm --parallel -r dev",
    "dev:clean": "node scripts/policy-data/kill-duplicate-ports.js && pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "kill-ports": "node scripts/policy-data/kill-duplicate-ports.js",
    "migrate:storage": "node scripts/policy-data/migrate-storage-schema.js",
    "migrate:storage:dump": "node scripts/policy-data/migrate-storage-schema.js",
    "migrate:storage:apply": "node scripts/policy-data/migrate-storage-schema.js",
    "migrate:storage:apply:ssh": "node scripts/policy-data/migrate-storage-schema.js"
  },
  "keywords": [
    "medical-insurer",
    "health-insurance",
    "south-africa",
    "compliance"
  ],
  "author": "KERVOX Team",
  "license": "PROPRIETARY",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@2.1.1": "2.1.7",
      "postcss": "8.5.23",
      "browserslist@4.28.4": "4.28.7",
      "@grpc/grpc-js@1.14.4": "1.14.5",
      "source-map-js@1.2.1": "1.2.2",
      "nanoid@3.3.15": "3.3.18",
      "protobufjs@7.6.4": "7.6.5",
      "postcss-selector-parser@6.1.4": "7.1.6"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "dotenv": "^17.2.4",
    "form-data": "^4.0.5",
    "pg": "^8.18.0"
  }
}
